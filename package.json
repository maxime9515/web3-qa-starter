{
  "name": "web3-qa-starter",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Tests the flows generic suites skip: wallet-flow E2E + DeFi money-math edge cases.",
  "license": "MIT",
  "author": "Maxim (https://github.com/maxime9515)",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxime9515/web3-qa-starter.git"
  },
  "homepage": "https://github.com/maxime9515/web3-qa-starter",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:demo": "playwright test --config=e2e/playwright.config.ts",
    "e2e:real": "playwright test --config=e2e/playwright.real.config.ts",
    "e2e:real:setup": "synpress e2e/wallet-setup",
    "e2e:real:install": "node node_modules/playwright-core/cli.js install chromium",
    "demo:serve": "node e2e/static-server.mjs",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@synthetixio/synpress": "^4.1.2",
    "@synthetixio/synpress-cache": "^0.0.14",
    "@types/node": "^22.20.5",
    "typescript": "5.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "viem": "^2.57.3"
  }
}
