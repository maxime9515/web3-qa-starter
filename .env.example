# E2E configuration (see README-e2e.md).
# Copy to .env and fill in locally. NEVER commit real values here.
# Empty value = use the default / skip the dependent test.
#
# There is intentionally NO seed / password / extension ENV: the REAL suite
# onboards from the PUBLIC hardhat/anvil test mnemonic and a throwaway password
# hardcoded in e2e/wallet-setup/basic.setup.ts (no secret required).

E2E_BASE_URL=
E2E_CHAIN_ID=
E2E_RPC_URL=
E2E_WALLET_ADDRESS=
