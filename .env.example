# Real-wallet E2E configuration (see README-e2e.md).
# Copy to .env and fill in locally. NEVER commit real values here —
# seed/password belong in a CI secret or your shell env only.
# Empty value = use the default / skip the dependent test.

E2E_BASE_URL=
E2E_CHAIN_ID=
E2E_RPC_URL=
E2E_WALLET_ADDRESS=
E2E_METAMASK_SEED=
E2E_METAMASK_PASSWORD=
E2E_METAMASK_EXTENSION=
